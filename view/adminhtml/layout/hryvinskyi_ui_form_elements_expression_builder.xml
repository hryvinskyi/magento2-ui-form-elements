<!--
    The expression builder's stylesheets, for an admin page whose form holds the builder. The page asks with
    <update handle="hryvinskyi_ui_form_elements_expression_builder"/> in its own layout file. The admin UI kit's
    stylesheet comes first, so the builder reads the kit's tokens; the builder's own stylesheet follows. A form
    rendered into a modal gets no head of its own, so the page that hosts the modal asks for this handle.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hryvinskyi_admin_ui"/>
    <head>
        <css src="Hryvinskyi_UiFormElements::css/expression-builder.css"/>
    </head>
</page>
